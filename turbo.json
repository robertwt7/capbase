{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "DATABASE_URL",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "CORS_ORIGIN",
    "TRUST_PROXY",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "ADMIN_NAME",
    "API_URL",
    "SITE_URL",
    "NEXT_PUBLIC_GA_ID",
    "TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET",
    "SENTRY_DSN",
    "GIT_SHA",
    "SEC_USER_AGENT",
    "CRON_SCHEDULE",
    "INGEST_ON_BOOT",
    "NODE_ENV",
    "PORT",
    "INGEST_LIMIT",
    "INGEST_DAYS",
    "INGEST_SKIP_FUNDS",
    "INGEST_SOURCES",
    "WDQS_USER_AGENT",
    "TECH_DETAILS_ENABLED",
    "TECH_ENRICHMENT_ENABLED",
    "TECH_ENRICHMENT_COMPANY_IDS",
    "TECH_ENRICHMENT_SCHEDULE",
    "TECH_ENRICHMENT_LIMIT",
    "TECH_ENRICHMENT_TIMEOUT_MS",
    "TECH_ENRICHMENT_REFRESH_DAYS",
    "TECH_ENRICHMENT_USER_AGENT",
    "TECH_ENRICHMENT_HEARTBEAT_URL",
    "EPO_OPS_CONSUMER_KEY",
    "EPO_OPS_CONSUMER_SECRET",
    "REPAIR_TARGET_ID",
    "REPAIR_TEST_DATABASE_URL"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "src/generated/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "test:e2e": {}
  }
}
