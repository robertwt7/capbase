generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  /// Granted by an admin only: may mint contributor API keys for /v1 and always sees
  /// complete company profiles. Moderates nothing.
  CONTRIBUTOR
  ADMIN
}

// Moderation state of a crowdsourced row. Public reads only return APPROVED.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Ledger of applied seed phases (Flyway-style). The seed runner
// (prisma/seed.ts) only executes phases not recorded here; `--baseline` marks
// phases as applied without running them (for DBs that predate the runner).
/// One forgot-password link. Only the SHA-256 of the token is stored, so a
/// database leak can't be replayed into account takeovers.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A single-use email-verification link. Mirrors PasswordResetToken: only the sha256 of the
/// token is stored, and issuing a new one deletes the user's older unused ones.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The address the link was sent to. Spending it requires this to still be the user's
  /// email, so a link mailed to an old address can never verify a new one.
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SeedHistory {
  name      String   @id
  appliedAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  /// Bumped on password change/reset and on ban; a JWT carrying an older
  /// version is rejected, which is how sessions are revoked server-side.
  tokenVersion Int       @default(0)
  /// Set by an admin. A banned user can't sign in, and every live session dies.
  bannedAt     DateTime?
  /// Set when the user spends an email-verification link; cleared when they change their
  /// email. Contributions require it (admins exempt). Existing users were backfilled to createdAt.
  emailVerifiedAt DateTime?

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  companies      Company[]
  rounds         FundingRound[]
  people         PersonRole[]
  investors      InvestorHolding[]
  investorFirms  Investor[]
  acquisitions   AcquisitionDeal[]
  exits          ExitEvent[]
  diversity      DiversitySignal[]
  proposals      ChangeProposal[]
  savedCompanies SavedCompany[]
  citations      Citation[]
  revisions      Revision[]
  funds          Fund[]
  mergeDecisions MergeCandidate[]
  merges         MergeRecord[]
  reportsResolved Report[]
  apiKeys         ApiKey[]
  investorProposals InvestorChangeProposal[]
}

/// A primary document a fact came from. Deduplicated by URL, so many citations
/// share one row (every round from one Form D cites the same filing).
model Source {
  id         String  @id @default(cuid())
  url        String  @unique
  sourceType String // one of SOURCE_TYPES
  title      String?
  publisher  String? // 'SEC', 'Wikidata', …
  /// Source-native reference: SEC accession, Wikidata QID, CRD number.
  reference  String?
  /// When the content behind `url` was last read. Backfilled rows use the
  /// cited row's updatedAt as the best available proxy.
  retrievedAt DateTime
  createdAt   DateTime @default(now())

  citations Citation[]

  @@index([sourceType])
}

/// Binds a Source to a specific fact. `field` is '' when the whole row is
/// attested, or a column name for a field-level citation. Non-nullable
/// because Postgres treats NULLs as distinct, which would defeat @@unique.
model Citation {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// One of CITABLE_TYPES. Polymorphic by design: a typed FK per entity would
  /// mean seven nullable columns and seven joins on every profile read.
  entityType String
  entityId   String
  field      String  @default("")
  note       String?

  submittedById String?
  submittedBy   User?    @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([sourceId, entityType, entityId, field])
  /// entityId first: the company profile and admin queue look citations up by
  /// id alone (a profile spans seven child types); everything else adds entityType.
  @@index([entityId, entityType])
}

/// One recorded change to published data. Anchored to a company so the profile
/// renders a single timeline across the company row and all its children.
model Revision {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  /// Column that changed; '' for whole-row CREATE events.
  field      String @default("")
  /// JSON-encoded values. BigInt columns are converted with Number() first.
  before     Json?
  after      Json?

  action      String // 'CREATE' | 'UPDATE' | 'MERGE' | 'UNMERGE'
  actor       String // 'USER' | 'ADMIN' | 'INGEST'
  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Ingest source name when actor = 'INGEST' (SEC_EDGAR, WIKIDATA, SEC_ADV).
  actorSource String?
  /// The proposal that produced this entry, when applicable.
  proposalId  String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

model Company {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  domain      String
  // Outbound links + Crunchbase-style metadata (all optional).
  websiteUrl      String?
  linkedinUrl     String?
  twitterUrl      String?
  legalName       String?
  operatingStatus String? // 'Active' | 'Closed' (validated in DTO)
  companyType     String? // 'For profit' | 'Non-profit'
  primarySector   String? // one of SECTORS; shared vocab with MarketStat.sector
  /// ISO 3166-1 alpha-2 (e.g. 'US', 'GB'), upper-case. Null when no source has
  /// stated a country — never guessed from a city name. `hq` stays the display
  /// string; this is the filterable fact.
  countryCode     String?
  oneLiner    String
  description String
  hq          String
  founded     Int
  headcount   Int
  industry    String[]
  // Domain status (Private/Public/Acquired) — distinct from moderationStatus.
  status      String
  stage       String
  totalRaisedUsd   BigInt
  lastValuationUsd BigInt?

  // Embedded financials (optional).
  revenueUsd       BigInt?
  revenueGrowthPct Float?
  grossMarginPct   Float?
  burnMonths       Int?

  // Provenance for ingested rows (e.g. SEC_EDGAR). Null for human contributions.
  externalSource String?
  externalId     String?

  /// Columns whose CURRENT value the licensed partner wrote (created, filled
  /// blank, or raised). The read gate masks them for signed-out viewers. Fail
  /// closed: a partner re-run never removes one; only a non-partner overwrite
  /// or an approved human edit does.
  partnerFields String[] @default([])
  /// The row exists only because of the partner: no other source has matched
  /// it. Signed-out viewers get a stub profile and never see it listed.
  partnerOnly   Boolean  @default(false)

  /// Set when an admin merged this row into another. The row is KEPT, not
  /// deleted: its slug still redirects, and its (externalSource, externalId)
  /// still absorbs the source's next re-ingest. Deleting it would free that key
  /// and the very next ingest run would recreate the duplicate.
  mergedIntoId String?
  mergedInto   Company?  @relation("CompanyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Company[] @relation("CompanyMerge")

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  rounds       FundingRound[]
  people       PersonRole[]
  investors    InvestorHolding[]
  acquisitions AcquisitionDeal[]
  exits        ExitEvent[]
  diversity    DiversitySignal[]
  proposals    ChangeProposal[]
  savedBy      SavedCompany[]
  revisions    Revision[]

  @@unique([externalSource, externalId])
  @@index([mergedIntoId])
  @@index([partnerOnly])
  /// Admin queue: one status, newest first, cursor on (createdAt, id).
  @@index([moderationStatus, createdAt, id])
  /// Contribution gate + pending cap: a user's rows in one status, newest first.
  @@index([submittedById, moderationStatus, createdAt])
  // Server-side directory filters/sorts always scope to APPROVED first.
  @@index([moderationStatus, primarySector])
  @@index([moderationStatus, countryCode])
  @@index([moderationStatus, stage])
  @@index([moderationStatus, status])
  @@index([moderationStatus, name])
  @@index([moderationStatus, totalRaisedUsd])
  /// `DESC NULLS LAST` in the migration SQL, as on Fund's size/vintage indexes.
  @@index([moderationStatus, lastValuationUsd(sort: Desc)])
  /// Trigram GIN index: directory search is `ILIKE '%q%'`, which no btree can serve.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_name_trgm_idx")
  @@index([oneLiner(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_oneLiner_trgm_idx")
  /// `GET /v1/companies?domain=`: the pre-create de-duplication lookup is a point read.
  @@index([domain])
}

// A company pinned to a user's personal watchlist.
model SavedCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
}

// A proposed correction to an existing Company's fields. `changes` holds only
// the edited fields ({ field: newValue }, whitelisted in the API DTO). Applied
// to the Company row when moderation approves it.
model ChangeProposal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changes   Json
  note      String?
  /// Optional source URL the contributor attached; materialised into per-field
  /// Citations when the proposal is approved.
  sourceUrl String?

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([companyId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

/// A field-level edit to an Investor firm (public API only). Unlike ChangeProposal it writes no
/// Revision (Revision.companyId is required and a firm has no company), so the values it replaced
/// are kept here, captured inside the approving transaction.
model InvestorChangeProposal {
  id         String   @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  changes    Json
  /// The firm's values for the changed fields just before approval; null until approved.
  previous   Json?
  note       String?
  /// The contributor's source. Stored here only: firm-level citations don't exist.
  sourceUrl  String?

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([investorId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

model FundingRound {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  date         DateTime
  amountUsd    BigInt
  postMoneyUsd BigInt?
  lead         String?
  /// Capital type: 'Equity' | 'Debt' | 'Grant' (ROUND_KINDS). Grants — SBIR/STTR
  /// awards — are real capital events but not raised capital, so they are
  /// excluded from Company.totalRaisedUsd and from the market tape's deal count
  /// while still rendering on the funding ladder.
  kind         String   @default("Equity")
  /// ISO 4217 of the amount as published. 'USD' for every pre-existing row.
  currency     String   @default("USD")
  /// The published amount in `currency`. Null when currency = 'USD' (then
  /// amountUsd IS the published figure). amountUsd is the FX-converted,
  /// comparable value every sort, total and bar width uses.
  amountLocal  BigInt?

  // Provenance for ingested rows (e.g. SEC_EDGAR). Null for human contributions.
  externalSource String?
  externalId     String?
  /// Columns the partner corrected on another source's round (see
  /// Company.partnerFields). A round the partner created is wholly partner
  /// data through `externalSource` instead.
  partnerFields  String[] @default([])

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  investors RoundInvestor[]

  @@unique([externalSource, externalId])
  @@index([companyId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

// Investors named on a specific round; inherits the round's review state.
model RoundInvestor {
  id      String       @id @default(cuid())
  roundId String
  round   FundingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  name    String
  lead    Boolean      @default(false)

  // Resolved link to the canonical firm. Nullable: `name` stays the source of
  // truth for rows whose firm we could not resolve.
  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  /// The ingest source that named this investor on the round; null for a
  /// contributed row. A round can carry rows from several sources, and each
  /// source replaces only its own.
  externalSource String?

  @@index([roundId])
  @@index([investorId])
}

// A first-class investor firm (VC, PE, accelerator, angel, …). Unlike
// InvestorHolding — which is one row per company↔investor pairing — an Investor
// exists on its own, so firms whose portfolio we don't know yet (the majority of
// the SEC Form ADV universe) still get a row and a page.
model Investor {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  legalName   String?
  type        String
  hq          String?
  /// ISO 3166-1 alpha-2, same contract as Company.countryCode.
  countryCode String?
  websiteUrl  String?
  linkedinUrl String?
  domain      String?
  description String?

  // Form ADV-derived facts; null on Wikidata-sourced and contributed rows.
  crdNumber   String?
  cikNumber   String?
  fundCount   Int?
  assetsUsd   BigInt?
  foundedYear Int?

  // Provenance for ingested rows (SEC_ADV, WIKIDATA). Null for human contributions.
  externalSource String?
  externalId     String?
  /// Same contract as Company.partnerFields / Company.partnerOnly.
  partnerFields  String[] @default([])
  partnerOnly    Boolean  @default(false)

  /// Set when an admin merged this row into another. Kept, not deleted, for the
  /// same reason as Company.mergedIntoId.
  mergedIntoId String?
  mergedInto   Investor?  @relation("InvestorMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Investor[] @relation("InvestorMerge")

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  holdings       InvestorHolding[]
  roundPositions RoundInvestor[]
  funds          Fund[]
  people         PersonRole[]
  proposals      InvestorChangeProposal[]
  /// Commitments this firm made to funds as a limited partner.
  commitments    FundCommitment[]

  @@unique([externalSource, externalId])
  @@index([mergedIntoId])
  @@index([partnerOnly])
  @@index([moderationStatus])
  @@index([moderationStatus, type])
  @@index([moderationStatus, countryCode])
  @@index([moderationStatus, name])
  /// Trigram GIN index: directory search is `ILIKE '%q%'`, which no btree can serve.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Investor_name_trgm_idx")
  @@index([domain])
}

/// One private fund managed by an Investor. Unlike Investor.fundCount — a
/// scalar rollup Form ADV reports at firm level — this names the fund, and
/// where a Form D filing matched, dates and sizes it.
model Fund {
  id   String @id @default(cuid())
  name String
  /// Manager. Required: a fund with no resolvable manager is not published —
  /// the ADV Schedule D join is the only structural route to one, and guessing
  /// it from the fund's name mis-attributes.
  managerId String
  manager   Investor @relation(fields: [managerId], references: [id], onDelete: Cascade)

  /// One of FUND_STRATEGIES. Null when neither source typed it.
  strategy String?
  /// Year the fund entity was formed (Form D `yearOfInc`) — the closest thing
  /// the public record has to a vintage. Form ADV discloses no inception date.
  vintageYear Int?
  /// Target raise (Form D `totalOfferingAmount`). Null when the filing says
  /// "Indefinite", which it does for 51–67% of pooled filings.
  targetUsd BigInt?
  /// Capital sold to date (Form D `totalAmountSold`).
  closedUsd BigInt?
  /// Gross asset value as last reported on Form ADV Schedule D 7.B.(1). NAV at
  /// filing time, NOT capital raised — the two are different facts.
  grossAssetsUsd BigInt?
  /// The directory's size sort key: grossAssetsUsd when Form ADV reports it,
  /// else closedUsd — exactly the figure the directory row shows. A column
  /// rather than an expression because Prisma can neither order by COALESCE nor
  /// declare an expression index. Ingest refreshes it on every fund write.
  sizeUsd BigInt?
  /// ISO 4217. Both sources report USD only; the column exists so a non-US
  /// source later cannot silently be read as dollars.
  currency String  @default("USD")
  hq       String?

  /// The fund page's address. Nullable only until `backfill-fund-slugs` has
  /// run everywhere; every write path mints one on create.
  slug String? @unique
  /// One of FUND_STATUSES. Only a data partner reports it; SEC funds stay null.
  status String?
  /// Lifecycle dates and terms, as a data partner publishes them. No public
  /// filing reports any of these, so SEC-only funds leave them null.
  launchDate         DateTime?
  latestCloseDate    DateTime?
  finalCloseDate     DateTime?
  hardCapUsd         BigInt?
  /// Percentages as published: 2.0 means 2%.
  managementFeePct     Float?
  carriedInterestPct   Float?
  hurdleRatePct        Float?
  targetIrrNetMinPct   Float?
  targetIrrNetMaxPct   Float?
  targetIrrGrossMinPct Float?
  targetIrrGrossMaxPct Float?
  regionFocus          String?

  /// SEC private fund identification number (805-XXXXXXXXXX), from Schedule D.
  secFundId String?
  /// The fund's own filer CIK, when a Form D filing matched it.
  cikNumber String?

  // Provenance for the row's creator (SEC_ADV_FUNDS | SEC_EDGAR). The *other*
  // source's identifier survives in secFundId / cikNumber, so both documents
  // stay citable however the row was created.
  externalSource String?
  externalId     String?
  /// Same contract as Company.partnerFields / Company.partnerOnly.
  partnerFields  String[] @default([])
  partnerOnly    Boolean  @default(false)

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([externalSource, externalId])
  @@index([managerId])
  @@index([partnerOnly])
  @@index([moderationStatus])
  @@index([moderationStatus, strategy])
  /// `(sort: Desc)` here, `DESC NULLS LAST` in the migration SQL: the reads sort
  /// nulls last, which a default btree can't serve backwards, and Prisma can't
  /// declare null ordering (it ignores it when diffing, so there is no drift).
  @@index([moderationStatus, vintageYear(sort: Desc), name])
  @@index([moderationStatus, grossAssetsUsd(sort: Desc), name])
  @@index([moderationStatus, sizeUsd(sort: Desc), name])
  @@index([moderationStatus, status])
  @@index([moderationStatus, name])
  /// Trigram GIN index: directory search is `ILIKE '%q%'`, which no btree can serve.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Fund_name_trgm_idx")

  commitments FundCommitment[]
  metrics     FundMetric[]
}

/// A limited partner's commitment to a fund. Ingest-only and auto-APPROVED, like
/// Fund; writes no revisions (there is no company to anchor them to).
///
/// No unique on (fundId, investorId): an investor merge can make two rows share
/// that pair, and — exactly as with InvestorHolding — leaving both keeps the
/// merge reversible. (externalSource, externalId) is the idempotency key.
model FundCommitment {
  id         String   @id @default(cuid())
  fundId     String
  fund       Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  /// The LP.
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  /// FX-converted comparable figure; null when the amount is undisclosed or no
  /// rate exists for the currency.
  amountUsd   BigInt?
  /// As published, in `currency`. Null for a USD commitment.
  amountLocal BigInt?
  currency    String   @default("USD")

  externalSource String?
  externalId     String?

  moderationStatus ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([externalSource, externalId])
  @@index([fundId])
  @@index([investorId])
}

/// A point-in-time figure for a fund: one row per fund per as-at date.
model FundMetric {
  id            String   @id @default(cuid())
  fundId        String
  fund          Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  asAt          DateTime
  dryPowderUsd  BigInt?
  aumUsd        BigInt?
  unrealizedUsd BigInt?

  externalSource String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([fundId, asAt])
}

model InvestorHolding {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  type       String
  firstRound String
  rounds     Int
  websiteUrl  String?
  linkedinUrl String?

  // Resolved link to the canonical firm. Nullable because seed phase 002 shipped
  // before this column existed and seed phases are immutable; every write path
  // (ingest + contribution) populates it.
  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  // Provenance for ingested rows (e.g. SEC_EDGAR, WIKIDATA). Null for human contributions.
  externalSource String?
  externalId     String?

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([externalSource, externalId])
  @@index([companyId])
  @@index([investorId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

/// One role: a person at a company or an investor firm.
///
/// This is the ORIGINAL `Person` table, renamed in place. Its row ids are
/// unchanged, which is why every `Citation` with entityType='person' stays
/// anchored and no citation migration was needed. `CitableType`/
/// `ReviewableType` 'person' still means THIS row, exactly as 'investor' means
/// `InvestorHolding` while `Investor` is a separate table.
model PersonRole {
  id String @id @default(cuid())

  /// The deduplicated human. Nullable on the same grounds as
  /// InvestorHolding.investorId: seed phase 002 creates people through a nested
  /// `people: { create: … }` and shipped seed phases are immutable. Every write
  /// path populates it and the backfill fills the seeded rows, so treat
  /// non-null as an invariant.
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  /// Exactly one of these is set. companyId became nullable when the investor
  /// side was added — every row that predates it has one.
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: Cascade)

  name String
  role String
  /// One of ROLE_KINDS, or null when the source's role is free text.
  kind  String?
  since Int
  /// When the role ended, when the source dates it. Null means "no end
  /// recorded", which is not the same as "still there".
  endYear     Int?
  prior       String?
  linkedinUrl String?
  title       String?

  /// Private contact details for this role, when a partner supplied
  /// them. Never read by any public path — see PersonContact.
  contact PersonContact?

  // Provenance for ingested rows (e.g. SEC_EDGAR, WIKIDATA). Null for human contributions.
  externalSource String?
  externalId     String?

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([externalSource, externalId])
  @@index([companyId])
  @@index([investorId])
  @@index([personId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

/// A human, deduplicated across every company and firm they appear at.
model Person {
  id   String @id @default(cuid())
  slug String @unique
  name String
  /// normalizeName(name) — the exact-equality dedup key, indexed so the ingest
  /// match index is one query rather than a scan.
  normalizedName String

  roles PersonRole[]
  /// PRIVATE. See PersonContact.
  contacts PersonContact[]

  /// Merge tombstone, identical in purpose to Company/Investor: the row is KEPT
  /// so its slug redirects and its identifiers stay claimed.
  mergedIntoId String?
  mergedInto   Person?  @relation("PersonMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Person[] @relation("PersonMerge")

  /// Set when someone asks to be removed (privacy policy §6). A SEPARATE column
  /// from moderationStatus, because ingest auto-APPROVES on every run and would
  /// flip a REJECTED row straight back — the suppression has to be a fact the
  /// ingest match index reads and honours, the same way it honours mergedIntoId.
  suppressedAt DateTime?

  /// Created by a source that resolves people by its own record id ONLY (a
  /// partner's contact id). Such a person is never matched by name —
  /// not by that source, and not by any later one — so the ingest index leaves
  /// them out of its name map. A column rather than a lookup of their
  /// identifiers, so the index need not hold half a million ids to know it.
  /// The partner is the only identifier-only source, so this is also the
  /// person's `partnerOnly`: the read gate hides such a person from signed-out
  /// viewers exactly as it hides a partner-only company, firm or fund.
  identifierOnly Boolean @default(false)

  moderationStatus ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([normalizedName])
  @@index([mergedIntoId])
  @@index([moderationStatus])
  @@index([moderationStatus, name])
  /// Trigram GIN index: directory search is `ILIKE '%q%'`, which no btree can serve.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Person_name_trgm_idx")
}

/// Professional contact details for a person at one organisation, licensed
/// from a data partner.
///
/// PRIVATE: no API mapper, /v1 route, search, sitemap, export or admin view
/// selects this table, and nothing here is ever written to Revision. The only
/// API code that touches it is the suppression delete (PeopleService) and the
/// merge remap (MergeService); `contact-privacy.e2e-spec.ts` guards that no
/// public response carries a value. Suppressing the person (Privacy §6)
/// deletes these rows.
///
/// One row per role, not per person: contact details are firm-specific — the
/// same human at two firms has two work emails.
model PersonContact {
  id       String      @id @default(cuid())
  personId String
  person   Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleId   String?     @unique
  role     PersonRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  email       String?
  phone       String?
  linkedinUrl String?

  externalSource String
  /// The role's provenance key, e.g. `${contactId}:${firmId}`.
  externalId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalSource, externalId])
  @@index([personId])
}

model AcquisitionDeal {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  target    String
  date      DateTime
  amountUsd BigInt?
  rationale String

  // Provenance for ingested rows (e.g. SEC_EDGAR, WIKIDATA). Null for human contributions.
  externalSource String?
  externalId     String?

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([externalSource, externalId])
  @@index([companyId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

model ExitEvent {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      String
  date      DateTime
  valueUsd  BigInt?
  detail    String

  // Provenance for ingested rows (e.g. SEC_EDGAR, WIKIDATA). Null for human contributions.
  externalSource String?
  externalId     String?

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([externalSource, externalId])
  @@index([companyId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

model DiversitySignal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  value     String
  note      String

  moderationStatus ReviewStatus @default(PENDING)
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([companyId])
  @@index([moderationStatus, createdAt, id])
  @@index([submittedById, moderationStatus, createdAt])
}

/// An external identifier for one Company or Investor — the crosswalk that lets
/// our rows be joined to anything else, and the strongest signal that two of
/// our rows are the same entity.
model EntityIdentifier {
  id     String @id @default(cuid())
  /// One of IDENTIFIER_SCHEMES.
  scheme String
  /// Canonical form, per normalizeIdentifier(). Values that fail validation are
  /// never stored — a malformed identifier joins unrelated entities, which is
  /// worse than having no identifier at all.
  value  String
  /// One of IDENTIFIABLE_TYPES. Polymorphic like Citation: Fund already carries
  /// secFundId/cikNumber, so a third identifiable type is coming, and a typed
  /// FK per entity would mean a migration to admit it.
  entityType String
  entityId   String
  /// Where it came from: an ingest source name, 'BACKFILL', or 'ADMIN'.
  source    String
  createdAt DateTime @default(now())

  /// Unique PER TYPE, not globally. Measured on the live corpus: four domains,
  /// two CIKs and one QID are held by a company row AND an investor row at once
  /// (Wefunder, Republic, Shadow, Red Cell) — one organisation that both raises
  /// and invests. Those are legitimate, so a global unique would reject real
  /// data on the very first backfill. Within one type a shared identifier IS a
  /// duplicate, and that is what this constraint catches.
  @@unique([scheme, value, entityType])
  @@index([entityType, entityId])
}

/// A pair of same-type rows that look like the same entity, awaiting an admin
/// decision. Kept after the decision so a rejected pair is never re-proposed.
model MergeCandidate {
  id         String @id @default(cuid())
  /// One of IDENTIFIABLE_TYPES. A company never pairs with an investor.
  entityType String
  /// The two rows, ordered so leftId < rightId — the @@unique then catches the
  /// pair whichever way round the detector found it.
  leftId  String
  rightId String
  /// One of MERGE_SIGNALS ('identifier' | 'domain' | 'name'), strongest first.
  signal String
  /// The value that matched ('CIK:0001234567', 'acme.com'), so the reviewer can
  /// check the proposal instead of guessing why it was made.
  evidence String
  /// One of MERGE_STATUSES: PENDING | MERGED | REJECTED.
  status      String    @default("PENDING")
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  records MergeRecord[]

  @@unique([entityType, leftId, rightId])
  @@index([status, entityType])
}

/// What one merge moved, complete enough to reverse it.
model MergeRecord {
  id         String @id @default(cuid())
  entityType String
  survivorId String
  losingId   String
  /// { rounds: [...ids], people: [...], savedCompanies: [{userId, createdAt}],
  /// identifiers: [{scheme, value, source}], … } — moved ids plus the full
  /// content of rows the merge had to DELETE (unique-constraint collisions),
  /// since an unmerge must recreate those rather than move them back.
  moved       Json
  candidateId String?
  candidate   MergeCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  mergedAt    DateTime        @default(now())
  mergedById  String?
  mergedBy    User?           @relation(fields: [mergedById], references: [id], onDelete: SetNull)
  /// Set when an admin reversed the merge. The record is kept either way: it is
  /// the audit trail for both directions.
  unmergedAt   DateTime?
  unmergedById String?

  @@index([entityType, survivorId])
  @@index([losingId])
}

/// A visitor's report about one public profile. Anonymous by design (Turnstile +
/// nginx rate limit, no account) so a person asking for removal never needs to
/// sign up. Never public; resolving it is bookkeeping — only a person report can
/// change the site, and only through an admin's explicit "Suppress & resolve".
model Report {
  id         String  @id @default(cuid())
  /// One of REPORTABLE_TYPES. 'person' means the Person row (the human).
  entityType String
  /// Company.id | Investor.id | Person.id — resolved from the slug at submission.
  entityId   String
  /// One of REPORT_REASONS.
  reason     String
  message    String
  /// Optional reporter contact — personal data (Privacy §2).
  email      String?

  /// One of REPORT_STATUSES.
  status         String    @default("OPEN")
  resolutionNote String?
  resolutionUrl  String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

/// A personal API key for /v1. Only the sha256 of the token is stored; the token is shown once.
/// The key's scope is a ceiling: the owner's CURRENT role must still permit it (ApiKeyGuard).
model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// 'contributor' | 'admin' (ApiKeyScope in @repo/api).
  scope        String
  /// `cbk_` + 8 random base62 chars; the lookup handle, safe to display.
  prefix       String    @unique
  /// sha256 hex of the full token. A high-entropy secret needs no slow hash.
  hash         String
  /// CIDRs the key may be used from; empty means any address.
  allowedCidrs String[]  @default([])
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
}
