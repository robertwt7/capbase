# Server-side base URL of the NestJS API (not exposed to the browser).
API_URL=http://localhost:3000

# Canonical public origin — used for metadata, sitemap, robots, JSON-LD, OG URLs.
SITE_URL=https://capbase.fyi

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile site key (read server-side per request). Leave empty to
# hide the challenge; pair it with TURNSTILE_SECRET on the API.
TURNSTILE_SITE_KEY=

# GlitchTip/Sentry DSN (server + browser, read at runtime). Leave empty to disable.
SENTRY_DSN=
