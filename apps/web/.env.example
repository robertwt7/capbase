# Server-side base URL of the NestJS API (not exposed to the browser).
API_URL=http://localhost:3000

# Canonical public origin — used for metadata, sitemap, robots, JSON-LD, OG URLs.
SITE_URL=https://capbase.fyi

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
