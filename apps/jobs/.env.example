# Postgres connection (matches root docker-compose.yml)
DATABASE_URL="postgresql://capbase:capbase@localhost:5433/capbase?schema=public"

# Optional HTTP health port for the worker (Docker healthcheck).
PORT=3002

# SEC requires a descriptive User-Agent with a contact email. Be a good citizen.
SEC_USER_AGENT="capbase-ingest (you@example.com)"

# Cron schedule for the daily SEC Form D ingest (node-cron syntax). 6am daily.
CRON_SCHEDULE="0 6 * * *"

# Run one ingest pass immediately on boot (useful in containers / first run).
INGEST_ON_BOOT="false"

# Max Form D filings to process per scheduled run (cron cap; the backfill CLI
# passes its own limit).
INGEST_LIMIT="500"

# How many days of filings each scheduled ingest covers (idempotent catch-up window).
INGEST_DAYS="3"

# Skip pooled investment funds / SPVs (the majority of Form D filers). "false" to keep them.
INGEST_SKIP_FUNDS="true"

# Comma-separated sources for the SCHEDULED ingest. WIKIDATA is also available
# but changes slowly — run it manually via `make ingest SOURCE=WIKIDATA`.
INGEST_SOURCES="SEC_EDGAR"

# User-Agent for the Wikidata Query Service (defaults to SEC_USER_AGENT).
# WDQS_USER_AGENT="capbase-ingest (you@example.com)"
