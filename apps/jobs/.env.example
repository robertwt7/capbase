# Postgres connection (matches root docker-compose.yml)
DATABASE_URL="postgresql://capbase:capbase@localhost:5433/capbase?schema=public"

# Optional HTTP health port for the worker (Docker healthcheck).
PORT=3002

# SEC requires a descriptive User-Agent with a contact email. Be a good citizen.
SEC_USER_AGENT="capbase-ingest (you@example.com)"

# Cron schedule for the daily SEC Form D ingest (node-cron syntax). 6am daily.
CRON_SCHEDULE="0 6 * * *"

# Run one ingest pass immediately on boot (useful in containers / first run).
INGEST_ON_BOOT="false"

# Max Form D filings to process per scheduled run (cron cap; the backfill CLI
# passes its own limit).
INGEST_LIMIT="500"

# How many days of filings each scheduled ingest covers (idempotent catch-up window).
INGEST_DAYS="3"

# Keep pooled investment funds / SPVs out of the COMPANY table (they are the
# majority of Form D filers and are not operating companies). They are still
# routed to the Fund table either way — this flag has never governed that.
INGEST_SKIP_FUNDS="true"

# Record a public Revision whenever ingest changes an already-published company
# field. Set "false" for a from-scratch rebuild, where the whole corpus is being
# created and a "history" of that creation is noise (see docs/DATA_REBUILD.md).
INGEST_RECORD_REVISIONS="true"

# Comma-separated sources for the SCHEDULED ingest. WIKIDATA, SEC_ADV and
# SEC_ADV_FUNDS are also available but change slowly (both ADV sources are
# snapshots) — run those manually via `make ingest SOURCE=WIKIDATA` /
# `make ingest SOURCE=SEC_ADV` / `make ingest-funds`.
INGEST_SOURCES="SEC_EDGAR"

# User-Agent for the Wikidata Query Service (defaults to SEC_USER_AGENT).
# WDQS_USER_AGENT="capbase-ingest (you@example.com)"

# --- SEC_ADV (Form ADV investor universe) ----------------------------------

# Which investor types to ingest from Form ADV. Hedge funds are opt-in: many are
# public-markets-only and would dilute a private-company investor directory.
# ADV_INVESTOR_TYPES="Venture,Private equity"

# Pin a specific monthly ADV snapshot for a reproducible run, e.g. "ia07012026".
# Unset = the most recent snapshot on the SEC index page. The published
# filenames are not pattern-stable, so the page is always scraped; the label is
# the shared `iaMMDDYYYY` prefix, and every run logs the one it resolved.
# ADV_SNAPSHOT="ia07012026"

# --- SEC_ADV_FUNDS (Form ADV Schedule D 7.B.(1) private funds) --------------

# Pin a specific cut of the Form ADV Part 1 data archives, e.g.
# "20111105-20241231". Unset = the newest cut linked from the SEC FOIA page.
# The archives are re-cut occasionally (not monthly) and the date range is part
# of the filename, so the page is always scraped; every run logs the label and
# both URLs it resolved. The archive starts on 2011-11-05 because Schedule D
# 7.B.(1) did not exist before the 2011 Form ADV revision.
# ADV_ARCHIVE="20111105-20241231"

# --- SEC_FORM_C (Regulation Crowdfunding offerings) -------------------------

# Oldest quarterly archive to walk, e.g. "2024q1". Unset = every quarter the SEC
# has published (2016q2 onward, 41 archives / ~13 MB). The index page is always
# scraped, so a quarter that does not exist yet is simply absent.
# FORM_C_MIN_QUARTER="2016q2"

# --- SBIR (federal SBIR/STTR award data) ------------------------------------

# Oldest award year that keeps a firm. A firm with any award from this year
# onward is ingested along with its FULL award history. Default 2015: 15,701
# firms and 134,101 awards. Set to 1983 for the full history: 34,285 firms and
# 219,503 awards.
# SBIR_MIN_YEAR="2015"

# --- SEC_S1 (principal-stockholder tables → investor edges) -----------------

# Oldest filing date to walk. EDGAR full-text search only covers 2001 onward;
# ~1,000 original S-1s are filed a year, so a 2015-onward walk is a few hours.
# S1_START_DATE="2015-01-01"

# Structural confidence a parsed ownership row must reach to be published
# (table found under a section heading 0.4, header names a beneficial owner 0.2,
# a percentage parsed 0.2, the name carries a legal-entity token 0.2).
# S1_MIN_CONFIDENCE="0.6"
