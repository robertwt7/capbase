# Postgres connection (matches root docker-compose.yml)
DATABASE_URL="postgresql://capbase:capbase@localhost:5433/capbase?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Email (Resend) — leave RESEND_API_KEY empty to disable sending (logged no-op)
RESEND_API_KEY=""
MAIL_FROM="Capbase <onboarding@resend.dev>"
