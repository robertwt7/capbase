# Postgres connection (matches root docker-compose.yml)
DATABASE_URL="postgresql://capbase:capbase@localhost:5433/capbase?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Email (Resend) — leave RESEND_API_KEY empty to disable sending (logged no-op)
RESEND_API_KEY=""
MAIL_FROM="Capbase <onboarding@resend.dev>"

# Public web origin, used for links in emails (password reset)
SITE_URL="http://localhost:3001"

# Comma-separated origins allowed to call the API from a browser. Leave unset:
# only the web server calls the API, server-side.
# CORS_ORIGIN=""

# Cloudflare Turnstile secret. Leave empty to skip the bot check (local dev, CI).
# The matching site key goes in the web app's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=""
