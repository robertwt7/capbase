{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "forceExit": true,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "astTransformers": { "before": ["<rootDir>/swagger-plugin.js"] } }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
