# ── Single-VPS env (make deploy-all) ──────────────────────────────────────
# Everything on one box. Copy to infra/env/all.env. DATABASE_URL points at the
# internal `postgres` service, so there's NO cross-VPS step to remember here.
# NOTE: keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
POSTGRES_USER=capbase
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=capbase
POSTGRES_BIND=127.0.0.1                   # loopback only — use `make db-tunnel` for remote psql
POSTGRES_PORT=5432

DATABASE_URL=postgresql://capbase:CHANGE_ME_strong_password@postgres:5432/capbase?schema=public

# ── Postgres tuning (defaults below are sized for an 8 GB VPS) ──
# After a resize: shared_buffers ≈ 25% RAM, effective_cache_size ≈ 50% RAM,
# and keep PG_MEM_LIMIT comfortably above shared_buffers.
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_MAINTENANCE_WORK_MEM=512MB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=50
PG_MEM_LIMIT=3g
PG_SHM_SIZE=256mb

# ── Container memory ceilings ──
API_MEM_LIMIT=768m
WEB_MEM_LIMIT=768m
JOBS_MEM_LIMIT=1536m

# ⚠️ Must match a `server_name` in infra/nginx/conf.d/capbase.conf — the vhost
#    hardcodes the domain, and `make deploy-tls` refuses to run if they differ.
DOMAIN=capbase.fyi
LETSENCRYPT_EMAIL=you@example.com
# Canonical origin for metadata/sitemap/robots — defaults to https://$DOMAIN,
# uncomment only if the public origin differs (e.g. a www subdomain).
#SITE_URL=https://capbase.fyi
NEXT_PUBLIC_GA_ID=                        # GA4 id (G-XXXXXXXXXX); empty disables GA
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=7d
TURNSTILE_SITE_KEY=                       # Cloudflare Turnstile; both empty disables the bot check
TURNSTILE_SECRET=
RESEND_API_KEY=
MAIL_FROM=Capbase <onboarding@resend.dev>
SEC_USER_AGENT=capbase-ingest (you@example.com)
CRON_SCHEDULE=0 6 * * *
INGEST_ON_BOOT=false
INGEST_LIMIT=50
ADMIN_EMAIL=admin@capbase.fyi
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_NAME=Capbase Admin

# ── Error tracking: self-hosted GlitchTip (make deploy-glitchtip-init) ──
# One project per app; paste each DSN after creating the projects. Empty = off.
WEB_SENTRY_DSN=
API_SENTRY_DSN=
JOBS_SENTRY_DSN=
# Filled in by `make deploy-glitchtip-init` (leave blank):
#GLITCHTIP_DB_PASSWORD=
#GLITCHTIP_SECRET_KEY=
#GLITCHTIP_EMAIL_URL=smtp://resend:<RESEND_API_KEY>@smtp.resend.com:587
#GLITCHTIP_FROM_EMAIL=errors@capbase.fyi

# ── Backups (make deploy-backup / deploy-backup-cron) ──
BACKUP_DIR=/var/backups/capbase
BACKUP_KEEP_DAYS=14
BACKUP_VERIFY=1                 # restore-verify every run; 0 to skip (not advised)
BACKUP_MIN_FREE_MB=2048         # refuse to back up below this much free space
# Off-site: put an rclone remote in infra/backup/rclone.conf (template:
# rclone.conf.example; `apt-get install -y rclone`) and every encrypted dump is
# copied to it — no setting needed here unless the remote/bucket differ.
#BACKUP_RCLONE_REMOTE=offsite:capbase-backups
# Escape hatch for anything rclone can't do; $BACKUP_FILE is set for it.
#BACKUP_UPLOAD_CMD=
# Failure alerts for backups (and future ops jobs): GlitchTip via
# JOBS_SENTRY_DSN (or OPS_SENTRY_DSN) and/or email via Resend to this address.
OPS_ALERT_EMAIL=
