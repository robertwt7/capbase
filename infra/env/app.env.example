# ── App VPS env (infra/docker-compose.app.yml) ────────────────────────────
# Copy to infra/env/app.env. Used by `make deploy-app`.
#
# ⚠️⚠️ ORDER MATTERS ⚠️⚠️
#   1. Deploy the DB first: `make deploy-db` on the DB VPS.
#   2. Set DATABASE_URL below to point at that DB VPS (private IP + creds).
#   3. THEN `make deploy-app`.
# `make deploy-app` refuses to run while DATABASE_URL still says CHANGE_ME.

# ── Database (split VPS) ──
#   postgresql://USER:PASS@<DB_VPS_PRIVATE_IP>:5432/capbase?schema=public
DATABASE_URL=postgresql://capbase:CHANGE_ME@CHANGE_ME_DB_HOST:5432/capbase?schema=public

# ── Public site / TLS (used in Phase 2) ──
DOMAIN=capbase.example.com               # domain pointed at THIS App VPS (A record)
LETSENCRYPT_EMAIL=you@example.com        # cert expiry notices
# Canonical origin for metadata/sitemap/robots — defaults to https://$DOMAIN,
# uncomment only if the public origin differs (e.g. a www subdomain).
#SITE_URL=https://capbase.example.com

# ── Analytics ──
NEXT_PUBLIC_GA_ID=                       # GA4 id (G-XXXXXXXXXX); empty disables GA

# ── Bot protection (Cloudflare Turnstile) — both empty disables it ──
# Create a widget at dash.cloudflare.com → Turnstile for $DOMAIN.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Auth ──
JWT_SECRET=CHANGE_ME_long_random_secret  # generate: openssl rand -hex 32
JWT_EXPIRES_IN=7d
# Encrypts authenticator-app (TOTP) secrets at rest — `make deploy-secrets` fills it
# (openssl rand -base64 32). Keep a copy with the other secrets: losing it makes every
# enrolled authenticator app unreadable (passkeys are unaffected).
MFA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# Roles that must use two-factor authentication. Empty = off: the first deploy, while
# admins and contributors enroll. Then set ADMIN,CONTRIBUTOR (or delete the line — that is
# the default) and redeploy. See infra/README.md → Two-factor authentication.
MFA_REQUIRED_ROLES=

# ── Email (Resend) — leave key empty to disable (logged no-op) ──
RESEND_API_KEY=
MAIL_FROM=Capbase <onboarding@resend.dev>

# ── Error tracking (GlitchTip DSNs; empty = off) ──
WEB_SENTRY_DSN=
API_SENTRY_DSN=
JOBS_SENTRY_DSN=

# ── SEC ingestion (jobs worker) ──
SEC_USER_AGENT=capbase-ingest (you@example.com)
CRON_SCHEDULE=0 6 * * *
INGEST_ON_BOOT=false
INGEST_LIMIT=50
# Dead man's switch, POSTed after every successful cron run (empty = off).
INGEST_HEARTBEAT_URL=
# Monthly snapshot ingest (UK sources). Empty MONTHLY_INGEST_SOURCES disables
# the job entirely; set INNOVATE_UK,COMPANIES_HOUSE once the first load is done
# (infra/README.md → "Adding a data source to a live production").
MONTHLY_INGEST_SOURCES=
MONTHLY_CRON_SCHEDULE=0 3 10 * *          # 03:00 on the 10th, after Companies House publishes
MONTHLY_INGEST_HEARTBEAT_URL=             # dead man's switch for the monthly run; empty = off
CH_SNAPSHOT=                              # pin a Companies House snapshot (YYYY-MM-01); empty = newest

# ── Moderation-queue emails to every admin (infra/README.md) ──
QUEUE_ALERT_THRESHOLD=100                 # alert when PENDING reaches this; 0 = off
QUEUE_DIGEST_CRON=0 8 * * *
QUEUE_DIGEST_TZ=UTC

# ── Seed admin (only `make deploy-seed`) ──
ADMIN_EMAIL=admin@capbase.fyi
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_NAME=Capbase Admin
